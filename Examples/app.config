<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <!-- SQL Server -->
    <add name="SqlServerDB"
         connectionString="Server=localhost;Database=DemoDB;User Id=sa;Password=1234;"
         providerName="System.Data.SqlClient" />

    <!-- MySQL -->
    <add name="MySqlDB"
         connectionString="Server=localhost;Database=DemoDB;User Id=root;Password=1234;Charset=utf8;"
         providerName="MySql.Data.MySqlClient" />

    <!-- Oracle -->
    <add name="OracleDB"
         connectionString="Data Source=localhost:1521/XE;User Id=system;Password=oracle;"
         providerName="Oracle.ManagedDataAccess.Client" />

    <!-- PostgreSQL -->
    <add name="PostgreSqlDB"
         connectionString="Host=localhost;Port=5432;Database=DemoDB;Username=postgres;Password=1234;"
         providerName="Npgsql" />
  </connectionStrings>

</configuration>
